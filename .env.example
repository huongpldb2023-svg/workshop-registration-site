# Sao chép file này thành .env.local (khi chạy thử ở máy) và KHÔNG commit file .env.local lên GitHub.
# Trên Vercel, các biến này được nhập trong Project Settings -> Environment Variables (xem HUONG_DAN.md).

# Email của Service Account (Google Cloud), dạng: ten-service-account@ten-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key của Service Account, lấy từ file JSON tải về (giữ nguyên các dấu \n)
GOOGLE_PRIVATE_KEY=

# ID của Google Sheet (lấy từ URL: https://docs.google.com/spreadsheets/d/ĐÂY_LÀ_ID/edit)
GOOGLE_SHEET_ID=1BvnD4IDt2VBpvkEVpbS_f7oqfJ8Ie1QMEybXD5Uas1A

# Tên tab trong Sheet (đúng như hiện tại)
GOOGLE_SHEET_TAB=Form Responses 1

# Link nhóm Zalo để chuyển khách sau khi đăng ký thành công
ZALO_GROUP_URL=https://zalo.me/g/wwrlccev26zu63pin3k0
